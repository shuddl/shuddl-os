{
  "name": "shuddl-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.15.0 <23",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "pnpm run test:tools && pnpm -r --if-present run test",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "check:runtime": "tsx tools/checks/runtime-contract.ts",
    "seed": "tsx tools/seed/generate.cli.ts",
    "seed:load": "tsx tools/seed/load.cli.ts",
    "check:invariants": "tsx tools/checks/invariants.ts",
    "check:rater-purity": "tsx tools/checks/rater-purity.ts",
    "check:authority-coverage": "tsx tools/checks/authority-coverage.ts",
    "db:lock": "tsx tools/checks/invariants.ts --write",
    "check:traceability": "tsx tools/traceability/orphans.ts",
    "check:coverage": "tsx tools/traceability/coverage.ts",
    "check:pr": "tsx tools/traceability/check-pr.ts",
    "check:identity": "tsx tools/checks/identity-leak.ts",
    "check:fixtures": "tsx tools/fixtures/verify.ts",
    "check:rater-parity": "tsx tools/rater/parity.ts",
    "check:invoice-parity": "tsx tools/rater/invoice-parity.ts",
    "check:concierge-parity": "tsx tools/concierge/parse-parity.ts",
    "check:seed": "tsx tools/seed/verify.ts",
    "audit:design": "tsx tools/design/audit.ts",
    "perf:map": "tsx tools/harness/playwright-guard.ts perf packages/map/playwright.config.ts",
    "test:visual": "tsx tools/harness/playwright-guard.ts visual playwright.config.ts",
    "test:acceptance": "tsx tools/acceptance/run.ts",
    "verify": "pnpm check:runtime && pnpm typecheck && pnpm lint && pnpm test && pnpm check:invariants && pnpm check:rater-purity && pnpm check:authority-coverage && pnpm check:traceability && pnpm check:coverage && pnpm check:identity && pnpm check:fixtures && pnpm check:rater-parity && pnpm check:invoice-parity && pnpm check:concierge-parity && pnpm check:seed && pnpm audit:design"
  },
  "devDependencies": {
    "@shuddl/contracts": "workspace:*",
    "@shuddl/ledger": "workspace:*",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
