{
  "name": "shuddl-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.15.0 <23",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "typecheck": "pnpm run typecheck:tools && pnpm -r --if-present run typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "pnpm run test:tools && pnpm -r --if-present run test",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "check:runtime": "tsx tools/checks/runtime-contract.ts",
    "seed": "tsx tools/seed/generate.cli.ts",
    "seed:load": "tsx tools/seed/load.cli.ts",
    "check:invariants": "tsx tools/checks/invariants.ts",
    "check:rater-purity": "tsx tools/checks/rater-purity.ts",
    "check:chokepoint": "tsx tools/checks/append-chokepoint.ts",
    "check:authority-coverage": "tsx tools/checks/authority-coverage.ts",
    "db:lock": "tsx tools/checks/invariants.ts --write",
    "check:traceability": "tsx tools/traceability/orphans.ts",
    "check:coverage": "tsx tools/traceability/coverage.ts",
    "check:pr": "tsx tools/traceability/check-pr.ts",
    "check:identity": "tsx tools/checks/identity-leak.ts",
    "check:citations": "tsx tools/checks/citation-links.ts",
    "check:tables": "tsx tools/docs/check-table-shape.ts",
    "check:surfaces": "tsx tools/deploy/surface-contract.ts",
    "check:fixtures": "tsx tools/fixtures/verify.ts",
    "check:rater-parity": "tsx tools/rater/parity.ts",
    "check:invoice-parity": "tsx tools/rater/invoice-parity.ts",
    "check:concierge-parity": "tsx tools/concierge/parse-parity.ts",
    "check:seed": "tsx tools/seed/verify.ts",
    "audit:design": "tsx tools/design/audit.ts",
    "perf:map": "tsx tools/harness/playwright-guard.ts perf packages/map/playwright.config.ts",
    "test:visual": "tsx tools/harness/playwright-guard.ts visual playwright.config.ts --project visual",
    "test:a11y": "tsx tools/harness/playwright-guard.ts a11y playwright.config.ts --project a11y",
    "test:e2e": "tsx tools/harness/playwright-guard.ts e2e playwright.config.ts --project e2e",
    "test:surfaces": "tsx tools/harness/playwright-guard.ts surfaces playwright.prod.config.ts --mode release",
    "preflight": "tsx tools/deploy/preflight.ts",
    "provision:prod": "tsx tools/deploy/provision-prod.ts",
    "backup": "tsx tools/deploy/backup.ts",
    "snapshot:ledger": "tsx tools/deploy/snapshot-ledger.ts",
    "restore:verify": "tsx tools/deploy/restore-verify.ts",
    "smoke:staging": "tsx tools/deploy/staging-smoke.ts",
    "build:surfaces": "VITE_API_BASE=https://api.shuddl.tech pnpm --filter @shuddl/command --filter @shuddl/portal --filter @shuddl/driver run build",
    "deploy:surfaces": "pnpm build:surfaces && pnpm check:surfaces -- --built && pnpm --filter @shuddl/command --filter @shuddl/portal --filter @shuddl/driver run deploy",
    "test:acceptance": "tsx tools/acceptance/run.ts",
    "verify:dev": "pnpm check:runtime && pnpm typecheck && pnpm lint && pnpm test && pnpm check:invariants && pnpm check:rater-purity && pnpm check:authority-coverage && pnpm check:traceability && pnpm check:coverage && pnpm check:identity && pnpm check:fixtures && pnpm check:rater-parity && pnpm check:invoice-parity && pnpm check:concierge-parity && pnpm check:seed && pnpm audit:design",
    "verify:merge": "tsx tools/release/run-gate.ts --profile merge",
    "verify:release": "tsx tools/release/run-gate.ts --profile release",
    "verify": "pnpm verify:dev",
    "check:bundles": "tsx tools/checks/bundle-ratchet.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "^4.20251230.0",
    "@playwright/test": "1.61.1",
    "@shuddl/contracts": "workspace:*",
    "@shuddl/ledger": "workspace:*",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
